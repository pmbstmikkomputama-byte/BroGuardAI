{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student profile and current risk status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nisn": { "type": "string" },
        "class": { "type": "string" },
        "lastAssessmentDate": { "type": "string", "format": "date-time" },
        "overallRisk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "attendance": { "type": "number" },
        "gradesTrend": { "type": "string", "enum": ["improving", "stable", "declining"] },
        "socialScore": { "type": "number" }
      },
      "required": ["name", "nisn", "class"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "A single psychological assessment for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "responses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" }
            }
          }
        },
        "behavioralData": {
          "type": "object",
          "properties": {
            "attendance": { "type": "number" },
            "grades_trend": { "type": "string", "enum": ["improving", "stable", "declining"] },
            "social_interaction": { "type": "number" }
          }
        },
        "aiAnalysis": {
          "type": "object",
          "properties": {
            "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
            "summary": { "type": "string" },
            "recommendations": { "type": "array", "items": { "type": "string" } },
            "factors": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["studentId", "timestamp", "responses", "behavioralData"]
    },
    "Question": {
      "title": "Question",
      "description": "A questionnaire question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["text"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student records"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Assessment records"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Managed questions"
    }
  }
}
