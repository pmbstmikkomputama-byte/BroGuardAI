rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'pmbstmikkomputama@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin'));
    }

    function isGuruBK() {
      return isAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'guru_bk');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isGuruBK());
      allow list: if isGuruBK();
      allow create: if isSignedIn() && request.auth.uid == userId && 
                      (incoming().role in ['siswa', 'guru_bk', 'admin']) &&
                      incoming().keys().hasAll(['uid', 'email', 'role', 'name']) &&
                      incoming().keys().size() >= 4;
      allow update: if isSignedIn() && request.auth.uid == userId && 
                      (isAdmin() || (incoming().role == existing().role && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'studentId', 'updatedAt'])));
      allow delete: if isAdmin();
    }

    // 2. Students Collection
    match /students/{studentId} {
      function isValidStudent(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.nisn is string && data.nisn.size() <= 20 &&
               data.class is string && data.class.size() <= 20;
      }

      allow read: if true; // Public read allowed for demo purposes. NOTE: Should be restricted in production.
      allow create: if isGuruBK() && isValidStudent(incoming()) && isValidId(studentId);
      allow update: if isGuruBK() && isValidStudent(incoming());
      allow delete: if isAdmin();
    }

    // 3. Assessments Collection
    match /assessments/{assessmentId} {
      function isValidAssessment(data) {
        return data.studentId is string && isValidId(data.studentId) &&
               (data.timestamp is string || data.timestamp is timestamp) &&
               data.responses is list && data.responses.size() <= 50;
      }

      allow get: if isSignedIn() && (isGuruBK() || (hasRole('siswa') && getUserData().studentId == resource.data.studentId));
      allow list: if isSignedIn() && (isGuruBK() || (hasRole('siswa') && getUserData().studentId == resource.data.studentId)); 
      allow create: if isSignedIn() && isValidAssessment(incoming()) && 
                      (isGuruBK() || (hasRole('siswa') && getUserData().studentId == incoming().studentId));
      allow update: if isGuruBK() && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['aiAnalysis', 'status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // 4. Questions Collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isGuruBK();
    }
  }
}
