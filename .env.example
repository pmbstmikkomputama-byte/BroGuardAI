# Gemini AI API Key
# --------------------
# 1. Dapatkan API Key di: https://aistudio.google.com/app/apikey
# 2. Jika Anda men-deploy ke Vercel, tambahkan variabel ini di Dashboard Vercel (Settings > Environment Variables)
#    Gunakan Nama: VITE_GEMINI_API_KEY
VITE_GEMINI_API_KEY=your_api_key_here

# Nama lama (untuk kompatibilitas local)
GEMINI_API_KEY=your_api_key_here

# App URL (Otomatis diisi oleh AI Studio)
APP_URL=
